{
  "openapi": "3.1.0",
  "info": {
    "title": "",
    "version": "version not set"
  },
  "paths": {
    "/v1/forfeit-txs": {
      "post": {
        "tags": [
          "EmulatorService"
        ],
        "description": "SubmitForfeitTxs signs forfeit transactions and boarding inputs on the commitment transaction.\nIt signs only when this Arkade signer's signature is in the BIP322 proof. The connector tree\nverifies the forfeits belong to the batch. Call SubmitProof before registering the proof with\narkd, then SubmitForfeitTxs when the batch finalizes.",
        "operationId": "EmulatorService_SubmitForfeitTxs",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitForfeitTxsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitForfeitTxsResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/info": {
      "get": {
        "tags": [
          "EmulatorService"
        ],
        "description": "GetInfo returns the Arkade signer's public key. The key is untweaked: tweak it with the\nArkade script hash before using it in a tapscript.",
        "operationId": "EmulatorService_GetInfo",
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInfoResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/offchain-tx": {
      "post": {
        "tags": [
          "EmulatorService"
        ],
        "description": "SubmitOffchainTx signs an Arkade transaction and its checkpoint transactions by executing\nArkade scripts on each input. The script runs only on the Arkade transaction, not on\ncheckpoints.",
        "operationId": "EmulatorService_SubmitOffchainTx",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitOffchainTxRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitOffchainTxResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/onchain-tx": {
      "post": {
        "tags": [
          "EmulatorService"
        ],
        "description": "SubmitOnchainTx signs a Bitcoin transaction by executing Arkade scripts\non each input whose tapscript contains the emulator's tweaked key.",
        "operationId": "EmulatorService_SubmitOnchainTx",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitOnchainTxRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitOnchainTxResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/proof": {
      "post": {
        "tags": [
          "EmulatorService"
        ],
        "description": "SubmitProof signs a BIP322 proof after validating its message and executing Arkade Script on\nthe proof transaction. The message may be any batch message type.",
        "operationId": "EmulatorService_SubmitProof",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitProofRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "a successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitProofResponse"
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Any": {
        "type": "object",
        "description": "Any contains an arbitrary schema along with a URL to help identify the type of the schema.",
        "properties": {
          "@type": {
            "type": "string",
            "description": "A URL/resource name that uniquely identifies the type of the schema."
          }
        }
      },
      "Bip322Proof": {
        "title": "Bip322Proof",
        "type": "object",
        "description": "Bip322Proof is a BIP322 proof. proof is the base64 PSBT and message is the canonical message\nthe proof signs.",
        "properties": {
          "message": {
            "type": "string"
          },
          "proof": {
            "type": "string"
          }
        }
      },
      "GetInfoRequest": {
        "title": "GetInfoRequest",
        "type": "object"
      },
      "GetInfoResponse": {
        "title": "GetInfoResponse",
        "type": "object",
        "properties": {
          "arkadeSignerPubkey": {
            "type": "string",
            "description": "hex-encoded compressed public key of the Arkade signer, untweaked."
          },
          "deprecatedArkadeSignerPubkeys": {
            "type": "array",
            "description": "hex-encoded compressed public keys of deprecated Arkade signers still accepted for signing.",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Status": {
        "title": "Status",
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Any"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SubmitForfeitTxsRequest": {
        "title": "SubmitForfeitTxsRequest",
        "type": "object",
        "properties": {
          "commitmentTx": {
            "type": "string"
          },
          "connectorTree": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TxTreeNode"
            }
          },
          "forfeits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "signedBip322Proof": {
            "$ref": "#/components/schemas/Bip322Proof"
          }
        }
      },
      "SubmitForfeitTxsResponse": {
        "title": "SubmitForfeitTxsResponse",
        "type": "object",
        "properties": {
          "signedCommitmentTx": {
            "type": "string"
          },
          "signedForfeits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubmitOffchainTxRequest": {
        "title": "SubmitOffchainTxRequest",
        "type": "object",
        "properties": {
          "arkadeTx": {
            "type": "string",
            "description": "base64 psbt of the Arkade transaction."
          },
          "checkpointTxs": {
            "type": "array",
            "description": "base64 psbts.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubmitOffchainTxResponse": {
        "title": "SubmitOffchainTxResponse",
        "type": "object",
        "properties": {
          "signedArkadeTx": {
            "type": "string"
          },
          "signedCheckpointTxs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubmitOnchainTxRequest": {
        "title": "SubmitOnchainTxRequest",
        "type": "object",
        "properties": {
          "tx": {
            "type": "string",
            "description": "base64 psbt"
          }
        }
      },
      "SubmitOnchainTxResponse": {
        "title": "SubmitOnchainTxResponse",
        "type": "object",
        "properties": {
          "signedTx": {
            "type": "string"
          }
        }
      },
      "SubmitProofRequest": {
        "title": "SubmitProofRequest",
        "type": "object",
        "properties": {
          "bip322Proof": {
            "$ref": "#/components/schemas/Bip322Proof"
          }
        }
      },
      "SubmitProofResponse": {
        "title": "SubmitProofResponse",
        "type": "object",
        "properties": {
          "signedProof": {
            "type": "string",
            "description": "base64 psbt of the proof with this Arkade signer's signature."
          }
        }
      },
      "TxTreeNode": {
        "title": "TxTreeNode",
        "type": "object",
        "properties": {
          "children": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tx": {
            "type": "string"
          },
          "txid": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "EmulatorService"
    }
  ]
}
